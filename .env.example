# Invoice Ninja v5 (self-hosted): copy to .env and fill in.

# Base URL of your instance, WITHOUT trailing slash and WITHOUT /api/v1.
# Example: https://your-instance.example.com
INVOICENINJA_BASE_URL=

# API token from Settings > Account Management > Integrations > API Tokens.
# Sent as the X-Api-Token header (v5).
INVOICENINJA_API_TOKEN=

# Optional request timeout in milliseconds (default 30000).
INVOICENINJA_TIMEOUT_MS=30000
