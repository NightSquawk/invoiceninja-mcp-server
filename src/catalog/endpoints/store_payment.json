{
  "slug": "store_payment",
  "operationId": "storePayment",
  "method": "POST",
  "path": "/api/v1/payments",
  "name": "Create payment",
  "category": "payments",
  "mutating": true,
  "description": "Adds an Payment to the system",
  "whenToUse": "Create a new payment, optionally applying it to invoices/credits and emailing a receipt, when recording a fresh payment (mutating).",
